# Hasil build live-build (besar / bisa dibuat ulang)
build/.build/
build/cache/
build/chroot/
build/binary/
build/local/

# Artefak build
build/*.iso
build/*.log
build/*.contents
build/*.files
build/*.packages
build/chroot.packages.*
build/binary.modified_timestamps
build/wget-log*

# Hook bawaan lb config (hook buatan tim diawali "ujianix-")
build/config/hooks/*/*
!build/config/hooks/*/ujianix-*

# Folder rilis ISO dan log uji lokal
release/
logs/
